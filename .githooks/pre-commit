#!/usr/bin/env bash
# Pre-commit gate (fast, change-aware): make precommit-fast (format BE+FE + lint
# + testmon-scoped tests) and a dashboard build ONLY when dashboard/ changed.
# Full mypy is intentionally excluded here (run `make precommit` / `make all`
# before a PR); CI enforces the full matrix.
# Enable once per clone:  make install-hooks
# Bypass (emergency only): SKIP_PRECOMMIT=1 git commit ...
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Remember staged paths so we can re-add them after auto-format rewrites the worktree.
# Portable (bash 3.2+): avoid `mapfile` (bash 4+ only).
STAGED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

echo "[pre-commit] make precommit-fast  (format-all + lint + testmon-scoped test)"
make precommit-fast

# If format rewrote files that were already staged, refresh the index so the
# commit includes the formatted content (worktree vs index drift).
if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    git add -- "${existing[@]}"
  fi
fi

# Rebuild the served SPA only when dashboard sources changed in this commit.
needs_build=0
for f in "${STAGED_FILES[@]}"; do
  if [[ "$f" == dashboard/* ]]; then
    needs_build=1
    break
  fi
done
if ((needs_build)); then
  echo "[pre-commit] dashboard changed — npm run build"
  (
    cd "$ROOT/dashboard"
    npm run build
  )
else
  echo "[pre-commit] no dashboard changes — skipping SPA build"
fi

echo "[pre-commit] all checks passed"
